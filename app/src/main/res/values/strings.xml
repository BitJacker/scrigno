    <string name="app_name" translatable="false">Scrigno</string>
    <string name="source_url" translatable="false">https://github.com/BitJacker/iniziare</string>
    <string name="about_description">Scrigno backs up the photos and videos of your phone to a server you own — a NAS, a home computer, a Raspberry Pi, a rented server — instead of Google Photos or iCloud. It can free up space on the phone while keeping every photo in the gallery.</string>
    <string name="about_libraries_title">Open source libraries</string>
    <string name="about_license">Scrigno is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License, version 3 or later. It comes with ABSOLUTELY NO WARRANTY.</string>
    <string name="about_license_title">License</string>
    <string name="about_privacy">No account, no analytics, no ads, no crash reports. The app connects only to the server you configure. Settings and password (encrypted with the Android Keystore) stay on this phone and are excluded from Android backups.</string>
