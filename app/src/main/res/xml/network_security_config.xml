<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Home servers often speak plain HTTP on the local network (WebDAV): it is allowed, and the app
        warns when a protocol is not encrypted. Certificates of a private CA installed by the user
        in the Android settings are trusted too.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
